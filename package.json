{
	"name": "little-later",
	"private": true,
	"description": "Little Later Chrome extension workspace",
	"version": "3.0.0",
	"license": "MIT",
	"author": "Thatikonda Mukesh",
	"homepage": "https://github.com/AndysTMC/Little-Later#readme",
	"bugs": {
		"url": "https://github.com/AndysTMC/Little-Later/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AndysTMC/Little-Later.git"
	},
	"type": "module",
	"packageManager": "bun@1.3.11",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "vite",
		"build:shared": "bun run --cwd packages/shared build",
		"build": "bun run build:shared && tsc -b && vite build",
		"preview": "vite preview",
		"test": "bun run build:shared && vitest run --environment jsdom --mode testing --passWithNoTests tests",
		"test:e2e": "playwright test",
		"screenshots": "playwright test -c playwright.visual.config.ts",
		"test:ai:live": "bun scripts/ai-live-smoke.ts",
		"test:ai:live:validate": "bun scripts/ai-live-validation.ts",
		"type-check": "tsc --noEmit -p tsconfig.app.json",
		"typecheck": "bun run --cwd packages/shared type-check && bun run type-check",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.7",
		"dexie": "^4.0.11",
		"dexie-react-hooks": "^1.1.7",
		"framer-motion": "^12.0.5",
		"little-shared": "workspace:*",
		"openai": "^4.86.2",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-markdown": "^10.1.0",
		"react-router": "^7.1.3",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.3.1",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"devDependencies": {
		"@crxjs/vite-plugin": "^3.0.0",
		"@eslint/js": "^10",
		"@js-temporal/polyfill": "^0.5.1",
		"@playwright/test": "^1.59.1",
		"@tailwindcss/vite": "^4.0.15",
		"@types/chrome": "^0.3.6",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"eslint": "^10",
		"eslint-plugin-react-hooks": "^7",
		"eslint-plugin-react-refresh": "^0.5",
		"fake-indexeddb": "^6.2.3",
		"fast-check": "^4.10.2",
		"globals": "^15.14.0",
		"jsdom": "^26.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.6.2",
		"typescript-eslint": "^8.18.2",
		"vite": "^6.2.5",
		"vitest": "^5.0.5"
	},
	"prettier": {
		"plugins": [
			"prettier-plugin-tailwindcss"
		],
		"tailwindStylesheet": "./src/popup/index.css",
		"useTabs": true,
		"tabWidth": 4
	}
}

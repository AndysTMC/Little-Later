{
	"manifest_version": 3,
	"name": "Little Later",
	"version": "3.3.0",
	"description": "A local-first Chrome extension for visual bookmarks, tasks, reminders, notes, and AI workflows.",
	"minimum_chrome_version": "144",
	"permissions": [
		"storage",
		"tabs",
		"activeTab",
		"unlimitedStorage",
		"contextMenus",
		"alarms",
		"idle",
		"declarativeNetRequest",
		"notifications",
		"sidePanel",
		"scripting"
	],
	"optional_permissions": ["nativeMessaging"],
	"host_permissions": ["<all_urls>"],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; img-src 'self' blob: data:"
	},
	"action": {
		"default_popup": "index.html"
	},
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"background": {
		"service_worker": "src/background/background.ts",
		"type": "module"
	},
	"icons": {
		"16": "icons/little-later-16x16.png",
		"48": "icons/little-later-48x48.png",
		"128": "icons/little-later-128x128.png"
	}
}
